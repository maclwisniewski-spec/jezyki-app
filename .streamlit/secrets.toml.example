# Przyklad konfiguracji secrets dla Streamlit (lokalnie .streamlit/secrets.toml lub Settings -> Secrets na Streamlit Cloud)

# Klucz API LingQ (z https://www.lingq.com/en/accounts/apikey/)
LINGQ_API_KEY = "twoj_klucz_api_lingq_tutaj"

# Opcjonalnie: automatyczna synchronizacja z GitHub (dla zachowania trwalosci zmian na Streamlit Cloud)
# GITHUB_TOKEN = "ghp_twoj_personal_access_token"
# GITHUB_REPO = "twoj_login/twoje_repo"
